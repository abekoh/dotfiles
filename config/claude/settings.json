{
  "env": {
    "USE_BUILTIN_RIPGREP": "1"
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(obsidian:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(gsed:*)",
      "Bash(awk:*)",
      "Bash(grep:*)",
      "Bash(go build:*)",
      "Bash(go mod tidy:*)",
      "Bash(go generate:*)",
      "Bash(go test:*)",
      "Bash(go tool:*)",
      "Bash(git add:*)",
      "Bash(git diff:*)",
      "Bash(herdr:*)",
      "Bash(hunk:*)",
      "mcp__serena",
      "mcp__context7"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Read(.env*)",
      "Bash(id_rsa)",
      "Bash(id_ed25519)",
      "Bash(**/.ssh/**)",
      "Edit(.env*)",
      "Edit(**/.ssh/**)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(chmod:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(git stash:*)",
      "Bash(git pull:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)"
    ],
    "additionalDirectories": [
      "~/obsidian/**"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '~/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "cloudflare@cloudflare": true,
    "codex@openai-codex": true,
    "modern-go-guidelines@goland-claude-marketplace": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "duckdb-skills": {
      "source": {
        "source": "github",
        "repo": "duckdb/duckdb-skills"
      }
    },
    "goland-claude-marketplace": {
      "source": {
        "source": "github",
        "repo": "JetBrains/go-modern-guidelines"
      }
    },
    "android-skills": {
      "source": {
        "source": "github",
        "repo": "android/skills"
      }
    },
    "material-3-skill": {
      "source": {
        "source": "github",
        "repo": "hamen/material-3-skill"
      }
    },
    "ansible-skills-marketplace": {
      "source": {
        "source": "github",
        "repo": "sigridjineth/hello-ansible-skills"
      }
    }
  },
  "language": "Japanese",
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "low"
    }
  },
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
