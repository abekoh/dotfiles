[core]
    pager = hunk pager

[diff]
    tool = hunk
    colorMoved = default

[difftool "hunk"]
    cmd = hunk difftool "$LOCAL" "$REMOTE" "$MERGED"

[difftool]
    prompt = false

[merge]
    conflictstyle = diff3

[ghq]
	root = ~/src

[wt]
	basedir = .worktrees
	copy = .env*
	hook = direnv allow . || true
